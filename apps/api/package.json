{
  "name": "@poke-event-alert/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/ingestion/*.test.ts src/sources/pokedata/*.test.ts",
    "source:pokedata": "tsx src/cli/fetch-pokedata.ts",
    "db:migrate": "tsx src/cli/migrate.ts",
    "ingest:pokedata": "tsx src/cli/ingest-pokedata.ts",
    "test:integration": "tsx --test --test-concurrency=1 src/**/*.integration.ts",
    "dev": "tsx watch src/cli/serve.ts",
    "start": "tsx src/cli/serve.ts",
    "notifications:send": "tsx src/cli/send-notifications.ts"
  },
  "dependencies": {
    "pg": "^8.16.0",
    "fastify": "^5.6.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@types/web-push": "^3.6.4"
  }
}
