rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function friendPairId(otherUid) {
      return request.auth.uid < otherUid
        ? request.auth.uid + '__' + otherUid
        : otherUid + '__' + request.auth.uid;
    }
    function isAcceptedFriend(otherUid) {
      let path = /databases/$(database)/documents/friendLinks/$(friendPairId(otherUid));
      return signedIn() && exists(path) && get(path).data.status == 'accepted';
    }

    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'followedVenueKeys', 'blockedVenues', 'settings', 'updatedAt'
        ])
        && request.resource.data.followedVenueKeys is list
        && request.resource.data.followedVenueKeys.size() <= 500
        && request.resource.data.blockedVenues is list
        && request.resource.data.blockedVenues.size() <= 500
        && request.resource.data.settings is map
        && request.resource.data.settings.keys().hasOnly([
          'challenge', 'cup', 'prerelease', 'other', 'discoveryRadiusKm'
        ])
        && request.resource.data.settings.challenge is bool
        && request.resource.data.settings.cup is bool
        && request.resource.data.settings.prerelease is bool
        && request.resource.data.settings.other is bool
        && request.resource.data.settings.discoveryRadiusKm is number
        && request.resource.data.settings.discoveryRadiusKm >= 0
        && request.resource.data.settings.discoveryRadiusKm <= 200;
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['playId', 'displayName', 'updatedAt'])
        && request.resource.data.playId is string
        && request.resource.data.playId.size() <= 32
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /friendLinks/{linkId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'requestedBy', 'status', 'updatedAt'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] != request.resource.data.members[1]
        && linkId == request.resource.data.members[0] + '__' + request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && resource.data.status == 'pending'
        && resource.data.requestedBy != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    match /eventAttendance/{eventId}/attendees/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAcceptedFriend(userId));
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'playId', 'displayName', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.playId is string
        && request.resource.data.playId.size() >= 3
        && request.resource.data.playId.size() <= 32
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80;
      allow delete: if signedIn() && request.auth.uid == userId;
    }
  }
}
